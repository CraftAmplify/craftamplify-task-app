# npm configuration for consistent package-lock.json generation
# This helps prevent lock file changes when students run npm install

# Use the public npm registry (overrides any corporate/private registry in ~/.npmrc)
registry=https://registry.npmjs.org/

# Always generate package-lock.json
package-lock=true

# Use lockfile version 3 (npm 7+)
lockfile-version=3

# Modern peer dependency resolution (npm 7+)
legacy-peer-deps=false

